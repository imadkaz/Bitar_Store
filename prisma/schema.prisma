// The database schema is owned by migrations/*.sql (run with `npm run migrate`).
// This file only MAPS the tables the code uses, so we add a model when a module needs it.
// Never run `prisma migrate` or `prisma db push` here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String
  passwordHash  String?   @map("password_hash")
  fullName      String    @map("full_name")
  role          String
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  version       Int       @default(1)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  allBranches   Boolean   @default(false) @map("all_branches")
  
  @@map("users")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String
  name      String
  kind      String   @default("branch")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  @@map("branches")
}

model UserBranchAccess {
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, branchId])
  @@map("user_branch_access")
}

model UserPermissionOverride {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  permission String
  effect     String
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, permission])
  @@map("user_permission_overrides")
}

model Style {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String
  name      String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  skus      Sku[]

  @@map("styles")
}

model Sku {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  styleId       String            @map("style_id") @db.Uuid
  skuCode       String            @map("sku_code")
  size          String
  color         String
  standardPrice Decimal           @map("standard_price") @db.Decimal(12, 2)
  currency      String            @default("USD") @db.Char(3)
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy     String?           @map("created_by") @db.Uuid
  updatedBy     String?           @map("updated_by") @db.Uuid
  version       Int               @default(1)
  style         Style             @relation(fields: [styleId], references: [id])
  barcodes      Barcode[]
  priceHistory  SkuPriceHistory[]

  @@map("skus")
}

model Barcode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  code      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  sku       Sku      @relation(fields: [skuId], references: [id])

  @@map("barcodes")
}

model SkuPriceHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuId       String   @map("sku_id") @db.Uuid
  oldPrice    Decimal? @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal  @map("new_price") @db.Decimal(12, 2)
  effectiveAt DateTime @default(now()) @map("effective_at") @db.Timestamptz(6)
  changedBy   String   @map("changed_by") @db.Uuid
  sku         Sku      @relation(fields: [skuId], references: [id])

  @@map("sku_price_history")
}


model IdempotencyKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  operation      String
  key            String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status") @db.SmallInt
  responseBody   Json?     @map("response_body")
  resourceType   String?   @map("resource_type")
  resourceId     String?   @map("resource_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}

model StockBalance {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  bucket    String   @default("sellable")
  quantity  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  @@map("stock_balances")
}

model StockMovement {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuId              String   @map("sku_id") @db.Uuid
  branchId           String   @map("branch_id") @db.Uuid
  bucket             String
  movementType       String   @map("movement_type")
  quantityDelta      Int      @map("quantity_delta")
  balanceAfter       Int      @map("balance_after")
  saleId             String?  @map("sale_id") @db.Uuid
  transferId         String?  @map("transfer_id") @db.Uuid
  adjustmentId       String?  @map("adjustment_id") @db.Uuid
  importBatchId      String?  @map("import_batch_id") @db.Uuid
  reversesMovementId String?  @map("reverses_movement_id") @db.Uuid
  reason             String?
  actorUserId        String   @map("actor_user_id") @db.Uuid
  idempotencyKeyId   String   @map("idempotency_key_id") @db.Uuid
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
   goodsReceiptId     String?  @map("goods_receipt_id") @db.Uuid

  @@map("stock_movements")
}

model StockAlert {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alertType         String    @default("insufficient_stock") @map("alert_type")
  operation         String
  branchId          String    @map("branch_id") @db.Uuid
  skuId             String    @map("sku_id") @db.Uuid
  requestedQuantity Int       @map("requested_quantity")
  availableQuantity Int       @map("available_quantity")
  actorUserId       String    @map("actor_user_id") @db.Uuid
  idempotencyKey    String?   @map("idempotency_key")
  requestId         String?   @map("request_id")
  acknowledgedBy    String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt    DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("stock_alerts")
}

model Sale {
  cashSessionId String? @map("cash_session_id") @db.Uuid
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference        String        @default(dbgenerated("('S-'::text || lpad((nextval('sale_ref_seq'::regclass))::text, 8, '0'::text))"))
  branchId         String        @map("branch_id") @db.Uuid
  soldBy           String        @map("sold_by") @db.Uuid
  status           String        @default("completed")
  currency         String        @default("USD") @db.Char(3)
  subtotalStandard Decimal       @map("subtotal_standard") @db.Decimal(12, 2)
  totalDiscount    Decimal       @map("total_discount") @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  soldAt           DateTime      @default(now()) @map("sold_at") @db.Timestamptz(6)
  businessDate     DateTime      @map("business_date") @db.Date
  idempotencyKeyId String        @unique @map("idempotency_key_id") @db.Uuid
  note             String?
  channel          String        @default("in_store")
  socialPlatform   String?       @map("social_platform")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy        String?       @map("created_by") @db.Uuid
  updatedBy        String?       @map("updated_by") @db.Uuid
  version          Int           @default(1)
  lines            SaleLine[]
  payments         SalePayment[]

  @@map("sales")
}

model SaleLine {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId            String   @map("sale_id") @db.Uuid
  lineNo            Int      @map("line_no") @db.SmallInt
  skuId             String   @map("sku_id") @db.Uuid
  quantity          Int
  unitPriceStandard Decimal  @map("unit_price_standard") @db.Decimal(12, 2)
  reductionType     String?  @map("reduction_type")
  reductionPercent  Decimal? @map("reduction_percent") @db.Decimal(5, 2)
  overrideUnitPrice Decimal? @map("override_unit_price") @db.Decimal(12, 2)
  reductionReason   String?  @map("reduction_reason")
  reducedBy         String?  @map("reduced_by") @db.Uuid
  lineStandardTotal Decimal  @map("line_standard_total") @db.Decimal(12, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(12, 2)
  sale              Sale     @relation(fields: [saleId], references: [id])

  @@map("sale_lines")
}

model SalePayment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId         String   @map("sale_id") @db.Uuid
  method         String
  amount         Decimal  @db.Decimal(12, 2)
  cashTendered   Decimal? @map("cash_tendered") @db.Decimal(12, 2)
  whishReference String?  @map("whish_reference")
  receivedBy     String   @map("received_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sale           Sale     @relation(fields: [saleId], references: [id])

  @@map("sale_payments")
}


model ReorderLevel {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuId          String   @map("sku_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  minQuantity    Int      @map("min_quantity")
  targetQuantity Int?     @map("target_quantity")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  version        Int      @default(1)

  @@unique([skuId, branchId], map: "reorder_levels_one_per_sku_branch")
  @@map("reorder_levels")
}

model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  details     Json     @default("{}")

  @@map("audit_events")
}

// Add these two models at the END of prisma/schema.prisma, then run: npx prisma generate
// (the tables transfers and transfer_lines already exist since migration 001: NO new migration for transfers)

model Transfer {
  expectedAt DateTime? @map("expected_at") @db.Timestamptz(6)
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference           String         @default(dbgenerated("('T-'::text || lpad((nextval('transfer_ref_seq'::regclass))::text, 8, '0'::text))"))
  sourceBranchId      String         @map("source_branch_id") @db.Uuid
  destinationBranchId String         @map("destination_branch_id") @db.Uuid
  status              String         @default("draft")
  requestedBy         String         @map("requested_by") @db.Uuid
  requestedAt         DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)
  dispatchedBy        String?        @map("dispatched_by") @db.Uuid
  dispatchedAt        DateTime?      @map("dispatched_at") @db.Timestamptz(6)
  note                String?
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy           String?        @map("created_by") @db.Uuid
  updatedBy           String?        @map("updated_by") @db.Uuid
  version             Int            @default(1)
  lines               TransferLine[]

  @@map("transfers")
}

model TransferLine {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferId    String   @map("transfer_id") @db.Uuid
  skuId         String   @map("sku_id") @db.Uuid
  requestedQty  Int      @map("requested_qty")
  dispatchedQty Int      @default(0) @map("dispatched_qty")
  receivedQty   Int      @default(0) @map("received_qty")
  resolvedQty   Int      @default(0) @map("resolved_qty")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version       Int      @default(1)
  transfer      Transfer @relation(fields: [transferId], references: [id])

  @@unique([transferId, skuId], map: "ux_transfer_lines_sku")
  @@map("transfer_lines")
}
// 1) In the EXISTING model User add this line before @@map:
//      deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
// 2) Add this model at the end of prisma/schema.prisma, then: npx prisma generate

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  @@map("categories")
}

model Adjustment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference        String   @default(dbgenerated("('A-'::text || lpad((nextval('adjustment_ref_seq'::regclass))::text, 8, '0'::text))"))
  branchId         String   @map("branch_id") @db.Uuid
  skuId            String   @map("sku_id") @db.Uuid
  bucket           String   @default("sellable")
  quantityDelta    Int      @map("quantity_delta")
  reason           String
  note             String
  adjustedBy       String   @map("adjusted_by") @db.Uuid
  idempotencyKeyId String   @unique @map("idempotency_key_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("adjustments")
}


model GoodsReceipt {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference             String   @default(dbgenerated("('GR-'::text || lpad((nextval('goods_receipt_ref_seq'::regclass))::text, 8, '0'::text))"))
  branchId              String   @map("branch_id") @db.Uuid
  supplierId            String   @map("supplier_id") @db.Uuid
  supplierName          String   @map("supplier_name")
  supplierInvoiceNumber String?  @map("supplier_invoice_number")
  invoiceDate           DateTime @map("invoice_date") @db.Date
  currency              String   @default("USD")
  note                  String?
  totalCost             Decimal  @map("total_cost") @db.Decimal(14, 2)
  receivedBy            String   @map("received_by") @db.Uuid
  idempotencyKeyId      String   @unique @map("idempotency_key_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lines                 GoodsReceiptLine[]

  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId String  @map("receipt_id") @db.Uuid
  skuId     String  @map("sku_id") @db.Uuid
  quantity  Int
  unitCost  Decimal @map("unit_cost") @db.Decimal(12, 2)
  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id])

  @@map("goods_receipt_lines")
}

// Add these two models at the END of prisma/schema.prisma, then: npx prisma generate

model Invoice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind              String
  status            String    @default("draft")
  reference         String?
  transferId        String?   @map("transfer_id") @db.Uuid
  saleId            String?   @map("sale_id") @db.Uuid
  issuerBranchId    String    @map("issuer_branch_id") @db.Uuid
  issuerName        String    @map("issuer_name")
  recipientBranchId String?   @map("recipient_branch_id") @db.Uuid
  recipientName     String?   @map("recipient_name")
  recipientPhone    String?   @map("recipient_phone")
  currency          String
  subtotal          Decimal   @db.Decimal(14, 2)
  discountTotal     Decimal   @default(0) @map("discount_total") @db.Decimal(14, 2)
  total             Decimal   @db.Decimal(14, 2)
  note              String?
  issuedBy          String    @map("issued_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finalizedAt       DateTime? @map("finalized_at") @db.Timestamptz(6)
  finalizedBy       String?   @map("finalized_by") @db.Uuid
  voidedAt          DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedBy          String?   @map("voided_by") @db.Uuid
  voidReason        String?   @map("void_reason")
  lines             InvoiceLine[]

  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  lineNo         Int     @map("line_no") @db.SmallInt
  skuId          String  @map("sku_id") @db.Uuid
  skuCode        String  @map("sku_code")
  description    String
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)
  priceSource    String? @map("price_source")
  invoice        Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_lines")
}

model Supplier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  phone     String?
  note      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("suppliers")
}
